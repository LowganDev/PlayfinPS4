{
  "version": 3,
  "configurePresets": [
    {
      "name": "linux-debug",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "linux-asan",
      "inherits": "linux-debug",
      "binaryDir": "${sourceDir}/build/linux-asan",
      "cacheVariables": {
        "PLAYFIN_SANITIZE": "ON"
      }
    },
    {
      "name": "ps4-release",
      "binaryDir": "${sourceDir}/build/ps4",
      "toolchainFile": "$env{OPENORBIS}/cmake/ps4.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PLATFORM_PS4": "ON"
      }
    },
    {
      "name": "linux-fuzz",
      "inherits": "linux-debug",
      "binaryDir": "${sourceDir}/build/linux-fuzz",
      "cacheVariables": {
        "PLAYFIN_FUZZ": "ON",
        "PLAYFIN_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan"
    },
    {
      "name": "ps4-release",
      "configurePreset": "ps4-release"
    },
    {
      "name": "linux-fuzz",
      "configurePreset": "linux-fuzz"
    }
  ],
  "testPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "abort_on_error=1:detect_leaks=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1",
        "LSAN_OPTIONS": "suppressions=${sourceDir}/tests/lsan.supp:print_suppressions=0"
      }
    },
    {
      "name": "linux-fuzz",
      "configurePreset": "linux-fuzz",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "fuzz"
        }
      }
    }
  ]
}
